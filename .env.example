# Copy to .env and fill in locally. Never commit .env.
# AWS credentials come from your local AWS CLI profile / IAM role, not from this file.

AWS_PROFILE=default
AWS_REGION=us-east-1

# Bedrock model IDs (LLM filled in at Step 11)
BEDROCK_LLM_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# "fake" = offline hashing embedder (no AWS, word overlap only); unset = Bedrock
FWLENS_EMBEDDER=

# Postgres (local docker compose, Step 8)
DATABASE_URL=postgresql+psycopg://fwlens:fwlens@127.0.0.1:5432/fwlens
