# Copy to .env and fill in locally. Never commit .env.
# AWS credentials come from your local AWS CLI profile / IAM role, not from this file.

AWS_PROFILE=default
AWS_REGION=us-east-1

# Bedrock model IDs (filled in at Steps 10-11)
BEDROCK_LLM_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=

# Postgres (local docker compose, Step 8)
DATABASE_URL=postgresql+psycopg://fwlens:fwlens@localhost:5432/fwlens
